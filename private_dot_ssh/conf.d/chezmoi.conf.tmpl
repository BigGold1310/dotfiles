{{- /* AddKeysToAgent is valid everywhere, including inside Codespaces/
   DevPod/Docker with no persistent agent, so this part is never gated.
   UseKeychain is Apple-only — vanilla/Linux OpenSSH hard-errors on unknown
   keywords, so it's omitted from the rendered file on non-macOS via the
   template branch (not just left in an unmatched Host block). */ -}}
Host *
    AddKeysToAgent yes
{{- if eq .chezmoi.os "darwin" }}
    UseKeychain yes
{{- end }}
{{- if not .codespaces }}

{{- /* Per-machine keys generated by run_once_after_generate-ssh-keys.sh.tmpl.
   Gated the same as that script: forcing IdentitiesOnly with an IdentityFile
   that doesn't exist would block falling back to a forwarded host agent
   inside Codespaces/DevPod/Docker. */}}

Host github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_github
    IdentitiesOnly yes

Host gitlab.com
    User git
    IdentityFile ~/.ssh/id_ed25519_gitlab
    IdentitiesOnly yes
{{- end }}
